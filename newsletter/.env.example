# ── 복사 후 .env 로 이름 변경 ──────────────────────────────────────────────
# .env 파일은 절대 git에 커밋하지 마세요!

# Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Stibee
STIBEE_API_KEY=...                      # 스티비 워크스페이스 설정 > API 키에서 발급
STIBEE_LIST_ID=...                      # 주소록 ID (스티비 주소록 URL에서 확인)
STIBEE_SENDER_NAME=노써치
STIBEE_SENDER_EMAIL=newsletter@nosearch.com
STIBEE_REPLY_TO=newsletter@nosearch.com

# 데이터 파일 경로 (로컬 실행 시)
DATA_EXCEL_PATH=data/nosearch_data.xlsx

# Google Drive (선택 — GitHub Actions에서 엑셀 자동 다운로드용)
# GDRIVE_FILE_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ
